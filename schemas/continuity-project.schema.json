{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mei continuity project v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_id",
    "context_id",
    "status",
    "goal",
    "decisions",
    "constraints",
    "blockers",
    "next_step",
    "stable_refs",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "v0.1.0"},
    "repo_id": {"type": "string", "pattern": "^repo-[a-f0-9]{32}$"},
    "context_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "status": {"enum": ["active", "blocked", "completed"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "decisions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "constraints": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "blockers": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "next_step": {"type": "string", "minLength": 1, "maxLength": 1000},
    "stable_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"enum": ["branch", "issue", "pull_request", "file"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
