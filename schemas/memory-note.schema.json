{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mei Markdown memory note v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "category", "status", "scope", "source"],
  "properties": {
    "schema_version": {"const": "v0.1.0"},
    "memory_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "category": {"enum": ["profile", "preferences", "domain", "procedural", "project", "feedback"]},
    "status": {"enum": ["active", "archived"]},
    "scope": {"type": "string", "minLength": 1, "maxLength": 240},
    "source": {"type": "string", "minLength": 1, "maxLength": 500},
    "review_required": {"type": "boolean"},
    "review_triggers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "relationships": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"}},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
