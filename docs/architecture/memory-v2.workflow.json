  "cards": [
    {
      "dot": "cyan",
      "title": "One canonical source",
      "items": [
        "Markdown is runtime truth and the direct Obsidian vault.",
        "MEMORY.md and registry are generated, not facts."
      ]
    },
    {
      "dot": "amber",
      "title": "Approval and paired writes",
      "items": [
        "Existing notes: proposal → preview → explicit approval.",
        "Stale targets stop; partial writes roll back or block reads."
      ]
    },
    {
      "dot": "rose",
      "title": "Separate technical protocols",
      "items": [
        "Continuity, trajectory and episodic JSON stay separate.",
        "Rollback selects one unchanged, manifest-created file."
      ]
    }
