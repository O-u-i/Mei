  "cards": [
    {
      "dot": "amber",
      "title": "Capability is not filesystem authority",
      "items": [
        "P2 creates only new preferences / project / feedback notes.",
        "Existing notes, relations and policies cannot use this shortcut."
      ]
    },
    {
      "dot": "rose",
      "title": "No silent repair",
      "items": [
        "Checkboxes express intent, never approval to execute.",
        "Relation check is read-only; repair drafts a proposal."
      ]
    }
  ]
