# Public template allowlist. New paths stay local until deliberately reviewed.
/*
!/.gitignore
!/README.md
!/VERSION
!/requirements.txt

# Generic configuration examples only.
!/.codex/
/.codex/**
!/.codex/config.example.toml
!/local/
/local/**
!/local/paths.example.toml
!/registry/
/registry/**
!/registry/memory.example.yaml
!/registry/projects.example.yaml
!/registry/skills.example.yaml

# Reusable schemas, base scripts, approved policies, and synthetic tests.
!/schemas/
/schemas/**
!/schemas/memory.schema.json
!/schemas/skill.schema.json
!/schemas/trajectory.schema.json
!/schemas/continuity-project.schema.json
!/schemas/continuity-checkpointer.schema.json
!/schemas/continuity-index.schema.json
!/schemas/memory-note.schema.json
!/schemas/memory-proposal.schema.json
!/scripts/
/scripts/**
!/scripts/_common.py
!/scripts/audit_skill.py
!/scripts/check_public_git.py
!/scripts/archive_trajectory.py
!/scripts/init_local.py
!/scripts/normalize_trajectory.py
!/scripts/rebuild_registry.py
!/scripts/validate_repository.py
!/scripts/validate_trajectory.py
!/scripts/check_continuity.py
!/scripts/checkpoint_continuity.py
!/scripts/create_continuity.py
!/scripts/continuity_adapters.py
!/scripts/sync_continuity.py
!/scripts/complete_continuity.py
!/scripts/memory_markdown.py
!/scripts/sync_obsidian.py
!/scripts/check_obsidian.py
!/scripts/migrate_codex_memory.py
!/scripts/migrate_memory.py
!/scripts/review_proposals.py
!/scripts/memory.py
!/scripts/relations.py
!/scripts/light_architecture.mjs
!/scripts/continuity_handoff.py
!/policies/
/policies/**
!/policies/memory-policy.md
!/policies/permissions-policy.md
!/policies/promotion-policy.md
!/policies/skill-policy.md
!/policies/trajectory-policy.md

# Reviewed, generic Archify diagrams used by the public README or retained as history.
!/docs/
/docs/**
/docs/learning/
!/docs/architecture/
!/docs/architecture/memory-read.architecture.json
!/docs/architecture/memory-read.html
!/docs/architecture/memory-read.svg
!/docs/architecture/memory-promotion.workflow.json
!/docs/architecture/memory-promotion.html
!/docs/architecture/memory-promotion.svg
!/docs/architecture/memory-v2.workflow.json
!/docs/architecture/memory-v2.workflow.html
!/docs/architecture/memory-v2.workflow.svg
# Planning, research, receipts, and other diagrams remain local.
!/tests/
/tests/**
!/tests/test_v0.py
!/tests/test_continuity.py
!/tests/test_checkpoint_continuity.py
!/tests/test_create_continuity.py
!/tests/test_adapters.py
!/tests/test_sync_continuity.py
!/tests/test_complete_continuity.py
!/tests/test_memory_markdown.py
!/tests/test_obsidian.py
!/tests/test_migrate_codex_memory.py
!/tests/test_v2_memory.py
!/tests/test_review_proposals.py
!/tests/test_continuity_handoff.py
!/evals/
!/evals/**/
/evals/**
!/evals/cases/
!/evals/cases/synthetic-task.json
!/evals/cases/.gitkeep
!/evals/datasets/
!/evals/datasets/.gitkeep
!/evals/reports/
!/evals/reports/.gitkeep

# Folder skeleton only. Every specific record or skill file remains local.
!/memory/
/memory/**
!/memory/**/
!/memory/**/.gitkeep
!/skills/
/skills/**
!/skills/**/
!/skills/**/.gitkeep
!/trajectories/
/trajectories/**
!/trajectories/**/
!/trajectories/**/.gitkeep
!/logs/
/logs/**
!/logs/.gitkeep

# Explicit local agent-rule/config exclusions, in addition to the allowlist.
/obsidian-vault/
/AGENTS.md
/AGENTS.override.md
/.agents/
/.codex/config.toml
/.codex/rules/
/.codex/skills/
