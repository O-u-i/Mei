# Public template allowlist. New paths stay local until deliberately reviewed.
/*
!/.gitignore
!/README.md
!/VERSION
!/requirements.txt

# Generic configuration examples only.
!/.codex/
/.codex/**
!/.codex/config.example.toml
!/local/
/local/**
!/local/paths.example.toml
!/registry/
/registry/**
!/registry/memory.example.yaml
!/registry/projects.example.yaml
!/registry/skills.example.yaml

# Reusable schemas, base scripts, approved policies, and synthetic tests.
!/schemas/
/schemas/**
!/schemas/memory.schema.json
!/schemas/skill.schema.json
!/schemas/trajectory.schema.json
!/scripts/
/scripts/**
!/scripts/_common.py
!/scripts/audit_skill.py
!/scripts/check_public_git.py
!/scripts/archive_trajectory.py
!/scripts/init_local.py
!/scripts/normalize_trajectory.py
!/scripts/rebuild_registry.py
!/scripts/validate_repository.py
!/scripts/validate_trajectory.py
!/policies/
/policies/**
!/policies/memory-policy.md
!/policies/permissions-policy.md
!/policies/promotion-policy.md
!/policies/skill-policy.md
!/policies/trajectory-policy.md

# Two reviewed, generic Archify diagrams used by the public README.
!/docs/
/docs/**
!/docs/architecture/
!/docs/architecture/memory-read.architecture.json
!/docs/architecture/memory-read.html
!/docs/architecture/memory-read.svg
!/docs/architecture/memory-promotion.workflow.json
!/docs/architecture/memory-promotion.html
!/docs/architecture/memory-promotion.svg
!/tests/
/tests/**
!/tests/test_v0.py
!/evals/
!/evals/**/
/evals/**
!/evals/cases/
!/evals/cases/synthetic-task.json
!/evals/cases/.gitkeep
!/evals/datasets/
!/evals/datasets/.gitkeep
!/evals/reports/
!/evals/reports/.gitkeep

# Folder skeleton only. Every specific record or skill file remains local.
!/memory/
/memory/**
!/memory/**/
!/memory/**/.gitkeep
!/skills/
/skills/**
!/skills/**/
!/skills/**/.gitkeep
!/trajectories/
/trajectories/**
!/trajectories/**/
!/trajectories/**/.gitkeep
!/logs/
/logs/**
!/logs/.gitkeep
